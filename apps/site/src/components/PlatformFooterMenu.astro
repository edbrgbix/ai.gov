---
const { content } = Astro.props;
import slugify from 'slugify';

const menuLabel = `platform-footer-${slugify(content.title, {
  lower: true,
})}`;
---

<p id={menuLabel} class="text-gray-500 mt-0 mb-4">{content.title}</p>
<ul class="add-list-reset mb-8" aria-labelledby={menuLabel}>
  {
    content.items.map(item => {
      return (
        <li class="block mb-4">
          <a
            href={item.url}
            class="hover:underline no-underline block text-black"
          >
            {item.title}
          </a>
        </li>
      );
    })
  }
</ul>
